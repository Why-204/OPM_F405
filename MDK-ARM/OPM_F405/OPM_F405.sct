; *************************************************************
; *** Scatter-Loading Description File (custom, 手动维护)    ***
; *** 注意：工程已关闭 "Use Memory Layout from Target Dialog"，***
; ***       本文件不再由 uVision 自动生成/覆盖。              ***
; *************************************************************

LR_IROM1 0x08000000 0x00100000  {    ; load region size_region
  ER_IROM1 0x08000000 0x00100000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x0001C000  {  ; RW data (SRAM1 112KB)
   .ANY (+RW +ZI)
  }
  RW_IRAM2 0x2001C000 0x00004000  {  ; SRAM2 16KB
   .ANY (+RW +ZI)
  }
  RW_IRAM_CCM 0x10000000 0x00010000  {  ; CCM 64KB (仅 CPU，DMA 不可访问)
   .ANY (.ccmram)
  }
}

